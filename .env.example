# Configuración del proveedor de modelo
# Por defecto se utiliza Groq con el modelo openai/gpt-oss-120b
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Alternativa: Configuración si se desea utilizar OpenAI
OPENAI_API_KEY=clave_configurada_localmente
OPENAI_MODEL=gpt-4o-mini
